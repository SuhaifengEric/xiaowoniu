# Database
DATABASE_URL="postgresql://user:password@localhost:5432/xiaowoniu?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"

# Build metadata (set by CI/deployment, never use a real secret here)
APP_VERSION="1.0.0"
BUILD_SHA="local"
BUILD_TIME="local"

# CORS
FRONTEND_URL="http://localhost:5173"

# Optional protected metrics endpoint. Omit this variable to keep /metrics disabled.
# METRICS_TOKEN="set-in-managed-secret-store"
