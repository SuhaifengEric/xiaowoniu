generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  email           String           @unique
  password        String
  nickname        String?
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fitnessCheckins FitnessCheckin[] @relation("UserFitnessCheckins")
  weightRecords   WeightRecord[]   @relation("UserWeightRecords")
  fitnessGoals    FitnessGoal[]    @relation("UserFitnessGoals")
  examCountdowns  ExamCountdown[]  @relation("UserExamCountdowns")
  studySubjects   StudySubject[]   @relation("UserStudySubjects")
  studyCheckins   StudyCheckin[]   @relation("UserStudyCheckins")
  expenses        Expense[]        @relation("UserExpenses")
  monthlyBudgets  MonthlyBudget[]  @relation("UserMonthlyBudgets")
  savingPlans     SavingPlan[]     @relation("UserSavingPlans")
  weddingTasks    WeddingTask[]    @relation("UserWeddingTasks")
  weddingExpenses WeddingExpense[] @relation("UserWeddingExpenses")
  weddingBudget   WeddingBudget?   @relation("UserWeddingBudget")
  marriageProcess MarriageProcess? @relation("UserMarriageProcess")

  @@map("users")
}

model FitnessCheckin {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation("UserFitnessCheckins", fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  activityType    String   @map("activity_type")
  durationMinutes Int      @map("duration_minutes")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("fitness_checkins")
}

model WeightRecord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("UserWeightRecords", fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  timeOfDay String   @map("time_of_day")
  weightKg  Decimal  @map("weight_kg") @db.Decimal(5, 2)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date, timeOfDay])
  @@map("weight_records")
}

model FitnessGoal {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation("UserFitnessGoals", fields: [userId], references: [id], onDelete: Cascade)
  targetWeightKg      Decimal?  @map("target_weight_kg") @db.Decimal(5, 2)
  weeklyWorkoutTarget Int       @map("weekly_workout_target")
  startDate           DateTime  @map("start_date") @db.Date
  targetDate          DateTime? @map("target_date") @db.Date
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("fitness_goals")
}

model ExamCountdown {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  user       User            @relation("UserExamCountdowns", fields: [userId], references: [id], onDelete: Cascade)
  examName   String          @map("exam_name") @db.VarChar(100)
  examDate   DateTime        @map("exam_date") @db.Date
  isArchived Boolean         @default(false) @map("is_archived")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  subjects   StudySubject[]  @relation("ExamStudySubjects")

  @@index([userId, isArchived, examDate])
  @@map("exam_countdowns")
}

model StudySubject {
  id                   String          @id @default(uuid())
  userId               String          @map("user_id")
  user                 User            @relation("UserStudySubjects", fields: [userId], references: [id], onDelete: Cascade)
  examId               String          @map("exam_id")
  exam                 ExamCountdown   @relation("ExamStudySubjects", fields: [examId], references: [id], onDelete: Cascade)
  subjectName          String          @map("subject_name") @db.VarChar(100)
  totalChapters        Int             @map("total_chapters")
  currentChapter       Int             @default(0) @map("current_chapter")
  progressPercentage   Int             @default(0) @map("progress_percentage")
  targetCompletionDate DateTime?       @map("target_completion_date") @db.Date
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  checkins             StudyCheckin[]  @relation("SubjectStudyCheckins")

  @@index([userId, examId])
  @@unique([examId, subjectName])
  @@map("study_subjects")
}

model StudyCheckin {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  user               User          @relation("UserStudyCheckins", fields: [userId], references: [id], onDelete: Cascade)
  subjectId          String        @map("subject_id")
  subject            StudySubject  @relation("SubjectStudyCheckins", fields: [subjectId], references: [id], onDelete: Cascade)
  date               DateTime      @db.Date
  completedChapters  Int[]         @map("completed_chapters")
  studyHours         Decimal       @map("study_hours") @db.Decimal(4, 2)
  notes              String?       @db.Text
  progressPercentage Int           @map("progress_percentage")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([subjectId, date])
  @@map("study_checkins")
}

model Expense {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation("UserExpenses", fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  amount        Decimal  @db.Decimal(12, 2)
  category      String   @db.VarChar(32)
  paymentMethod String   @map("payment_method") @db.VarChar(32)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([userId, category, date])
  @@map("expenses")
}

model MonthlyBudget {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("UserMonthlyBudgets", fields: [userId], references: [id], onDelete: Cascade)
  month     DateTime @db.Date
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, month])
  @@map("monthly_budgets")
}

model SavingPlan {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation("UserSavingPlans", fields: [userId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(100)
  targetAmount  Decimal  @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal  @default(0) @map("current_amount") @db.Decimal(12, 2)
  targetDate    DateTime @map("target_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deposits      SavingDeposit[] @relation("SavingPlanDeposits")

  @@index([userId, targetDate])
  @@map("saving_plans")
}

model SavingDeposit {
  id           String     @id @default(uuid())
  savingPlanId String     @map("saving_plan_id")
  savingPlan   SavingPlan @relation("SavingPlanDeposits", fields: [savingPlanId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(12, 2)
  date         DateTime?  @db.Date
  notes        String?    @db.Text
  source       String     @default("manual") @db.VarChar(32)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([savingPlanId, date, createdAt])
  @@map("saving_deposits")
}

model WeddingTask {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  user          User             @relation("UserWeddingTasks", fields: [userId], references: [id], onDelete: Cascade)
  taskName      String           @map("task_name") @db.VarChar(200)
  category      String           @db.VarChar(32)
  plannedDate   DateTime?        @map("planned_date") @db.Date
  completedDate DateTime?        @map("completed_date") @db.Date
  status        String           @default("pending") @db.VarChar(32)
  priority      Int              @default(3)
  notes         String?          @db.Text
  processId     String?          @map("process_id")
  process       MarriageProcess? @relation("MarriageProcessTasks", fields: [processId], references: [id], onDelete: SetNull)
  stageKey      String?          @map("stage_key") @db.VarChar(32)
  ownerRole     String?          @map("owner_role") @db.VarChar(32)
  completionCriteria String?     @map("completion_criteria") @db.VarChar(500)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  expenses      WeddingExpense[] @relation("WeddingTaskExpenses")

  @@index([userId, status, plannedDate])
  @@index([userId, category, plannedDate])
  @@index([processId, stageKey, plannedDate])
  @@map("wedding_tasks")
}

model MarriageProcess {
  id              String              @id @default(uuid())
  userId          String              @unique @map("user_id")
  user            User                @relation("UserMarriageProcess", fields: [userId], references: [id], onDelete: Cascade)
  recorderRole    String              @map("recorder_role") @db.VarChar(32)
  visitOrder      String              @default("male_first") @map("visit_order") @db.VarChar(32)
  marriageOrder   String              @default("registration_first") @map("marriage_order") @db.VarChar(32)
  engagementMode  String              @default("undecided") @map("engagement_mode") @db.VarChar(32)
  nodes           MarriageNode[]      @relation("MarriageProcessNodes")
  agreements      AgreementTopic[]    @relation("MarriageProcessAgreements")
  histories       MarriageNodeHistory[] @relation("MarriageProcessHistories")
  tasks           WeddingTask[]       @relation("MarriageProcessTasks")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("marriage_processes")
}

model MarriageNode {
  id             String                @id @default(uuid())
  processId      String                @map("process_id")
  process        MarriageProcess       @relation("MarriageProcessNodes", fields: [processId], references: [id], onDelete: Cascade)
  nodeKey        String                @map("node_key") @db.VarChar(32)
  status         String                @default("not_started") @db.VarChar(32)
  plannedDate    DateTime?             @map("planned_date") @db.Date
  actualDate     DateTime?             @map("actual_date") @db.Date
  participants   String?               @db.VarChar(500)
  conclusion     String?               @db.Text
  disagreements  String?               @db.Text
  nextStep       String?               @map("next_step") @db.Text
  notes          String?               @db.Text
  skipReason     String?               @map("skip_reason") @db.VarChar(500)
  backfilled     Boolean               @default(false)
  histories      MarriageNodeHistory[] @relation("MarriageNodeHistories")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@unique([processId, nodeKey])
  @@index([processId, status, plannedDate])
  @@map("marriage_nodes")
}

model AgreementTopic {
  id          String          @id @default(uuid())
  processId   String          @map("process_id")
  process     MarriageProcess @relation("MarriageProcessAgreements", fields: [processId], references: [id], onDelete: Cascade)
  title       String          @db.VarChar(100)
  status      String          @default("not_discussed") @db.VarChar(32)
  sortOrder   Int             @default(0) @map("sort_order")
  notes       String?         @db.Text
  archivedAt  DateTime?       @map("archived_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([processId, archivedAt, sortOrder])
  @@map("agreement_topics")
}

model MarriageNodeHistory {
  id              String          @id @default(uuid())
  processId       String          @map("process_id")
  process         MarriageProcess @relation("MarriageProcessHistories", fields: [processId], references: [id], onDelete: Cascade)
  nodeId          String          @map("node_id")
  node            MarriageNode    @relation("MarriageNodeHistories", fields: [nodeId], references: [id], onDelete: Cascade)
  eventType       String          @map("event_type") @db.VarChar(64)
  fromStatus      String?         @map("from_status") @db.VarChar(32)
  toStatus        String?          @map("to_status") @db.VarChar(32)
  fromPlannedDate DateTime?       @map("from_planned_date") @db.Date
  toPlannedDate   DateTime?       @map("to_planned_date") @db.Date
  fromActualDate  DateTime?       @map("from_actual_date") @db.Date
  toActualDate    DateTime?       @map("to_actual_date") @db.Date
  reason          String?         @db.VarChar(500)
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([processId, nodeId, createdAt])
  @@map("marriage_node_histories")
}

model WeddingExpense {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  user          User         @relation("UserWeddingExpenses", fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?      @map("task_id")
  task          WeddingTask? @relation("WeddingTaskExpenses", fields: [taskId], references: [id], onDelete: SetNull)
  date          DateTime     @db.Date
  itemName      String       @map("item_name") @db.VarChar(200)
  category      String       @db.VarChar(32)
  plannedAmount Decimal      @map("planned_amount") @db.Decimal(12, 2)
  actualAmount  Decimal      @map("actual_amount") @db.Decimal(12, 2)
  paidStatus    String       @map("paid_status") @db.VarChar(32)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([userId, category, date])
  @@index([userId, paidStatus, date])
  @@index([taskId])
  @@map("wedding_expenses")
}

model WeddingBudget {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation("UserWeddingBudget", fields: [userId], references: [id], onDelete: Cascade)
  totalBudget Decimal  @map("total_budget") @db.Decimal(12, 2)
  weddingDate DateTime @map("wedding_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("wedding_budgets")
}
